#!/usr/bin/env python3
"""threads: the skill's upkeep script, run by the agent itself.

A thin adapter over threads_core (packaged beside this file). `init [user]`
creates a scope; every other subcommand works on the scope resolved from the
current directory, runs the core's upkeep first, and is silent when no scope
exists. `start` prints the briefing (its data sections: the rules are in
SKILL.md) and snapshots `.threads/`; `check` lists the threads modified since
that snapshot that are still hanging. `ack <id>|all` acknowledges retirement notices, after the agent
has told the user about them. In a scope with a newer or unreadable
contract nothing is written: `regen` prints the warning and `ack` refuses.
"""
import os
import shlex
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import threads_core  # noqa: E402

USAGE = ("usage: threads init [user] | threads start | threads check | threads regen"
         " | threads ack <id>|all\n")

# The one snapshot `start` takes and `check` compares with.
SNAPSHOT = os.path.join(".state", "skill", "snapshot.json")  # inside `.threads/`

CHECK_HEADER = (
    "# Hanging threads\n"
    "\n"
    "Modified since `threads start`, still `open` or `proposed`, not touched today.\n"
    "Declare each one's outcome before the final reply: resolved, deferred,\n"
    "abandoned, or still open with an updated position; set `touched` to today.\n"
    "\n"
)
NO_SNAPSHOT = "No snapshot to compare with: run `threads start` first.\n"

SCRIPT = os.path.abspath(__file__)


def cmd_init(args):
    if args not in ([], ["user"]):
        sys.stderr.write(USAGE)
        return 2
    created, text = threads_core.run_init(os.getcwd(), user=bool(args))
    sys.stdout.write(text)
    return 0 if created else 1


def ack_command(scope, target):
    """The exact shell command line that acknowledges `target` in `scope`."""
    return "cd %s && python3 %s ack %s" % (shlex.quote(scope.root), shlex.quote(SCRIPT), target)


def cmd_start(scope, args):
    if args:
        sys.stderr.write(USAGE)
        return 2
    result = threads_core.upkeep(scope)
    brief = threads_core.briefing(scope, result, lambda t: ack_command(scope, t))
    if not threads_core.contract_warning(scope):
        threads_core.write_state(os.path.join(scope.threads_dir, SNAPSHOT),
                                 {"snapshot": threads_core.take_snapshot(scope)})
    sys.stdout.write(brief.text())
    return 0


def cmd_check(scope, args):
    if args:
        sys.stderr.write(USAGE)
        return 2
    result = threads_core.upkeep(scope)
    warning = threads_core.contract_warning(scope)
    if warning:
        # Nothing can be settled in a read-only scope: say why instead.
        sys.stdout.write(warning)
        return 0
    state = threads_core.read_state(os.path.join(scope.threads_dir, SNAPSHOT))
    if state is None or not isinstance(state.get("snapshot"), dict):
        sys.stdout.write(NO_SNAPSHOT)
        return 1
    threads = threads_core.hanging(scope, state["snapshot"], result)
    if threads:
        sys.stdout.write(CHECK_HEADER + threads_core.render_hanging(threads))
    return 0


def cmd_regen(scope, args):
    threads_core.upkeep(scope)
    # A read-only scope was not regenerated: say why.
    sys.stdout.write(threads_core.contract_warning(scope))
    return 0


def cmd_ack(scope, args):
    if len(args) != 1 or not (args[0] == "all" or threads_core.valid_id(args[0])):
        sys.stderr.write(USAGE)
        return 2
    try:
        done = threads_core.ack(scope, args[0])
    except threads_core.ReadOnlyScope as refused:
        sys.stdout.write(str(refused))
        return 1
    sys.stdout.write(threads_core.ack_text(done, args[0]))
    return 0


COMMANDS = {"start": cmd_start, "check": cmd_check, "regen": cmd_regen, "ack": cmd_ack}


def main(argv):
    if argv and argv[0] == "init":
        return cmd_init(argv[1:])
    if not argv or argv[0] not in COMMANDS:
        sys.stderr.write(USAGE)
        return 2
    scope = threads_core.resolve_scope(os.getcwd())
    if scope is None:
        return 0
    return COMMANDS[argv[0]](scope, argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
