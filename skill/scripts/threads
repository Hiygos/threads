#!/usr/bin/env python3
"""threads: the skill's upkeep script, run by the agent itself.

A thin adapter over threads_core (packaged beside this file). `init [user]`
creates a scope; every other subcommand works on the scope resolved from the
current directory, runs the core's upkeep first, and is silent when no scope
exists. `ack <id>|all` acknowledges retirement notices, after the agent has
told the user about them.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import threads_core  # noqa: E402

USAGE = "usage: threads init [user] | threads regen | threads ack <id>|all\n"


def cmd_init(args):
    if args not in ([], ["user"]):
        sys.stderr.write(USAGE)
        return 2
    created, text = threads_core.run_init(os.getcwd(), user=bool(args))
    sys.stdout.write(text)
    return 0 if created else 1


def cmd_regen(scope, args):
    threads_core.upkeep(scope)
    return 0


def cmd_ack(scope, args):
    if len(args) != 1 or not (args[0] == "all" or threads_core.valid_id(args[0])):
        sys.stderr.write(USAGE)
        return 2
    done = threads_core.ack(scope, args[0])
    sys.stdout.write(threads_core.ack_text(done, args[0]))
    return 0


COMMANDS = {"regen": cmd_regen, "ack": cmd_ack}


def main(argv):
    if argv and argv[0] == "init":
        return cmd_init(argv[1:])
    if not argv or argv[0] not in COMMANDS:
        sys.stderr.write(USAGE)
        return 2
    scope = threads_core.resolve_scope(os.getcwd())
    if scope is None:
        return 0
    return COMMANDS[argv[0]](scope, argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
