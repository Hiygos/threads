#!/usr/bin/env python3
"""threads: the skill's upkeep script, run by the agent itself.

A thin adapter over threads_core (packaged beside this file). Every subcommand
works on the scope resolved from the current directory and is silent when no
scope exists.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import threads_core  # noqa: E402

USAGE = "usage: threads regen\n"


def cmd_regen(scope, args):
    threads_core.regenerate(scope)
    return 0


COMMANDS = {"regen": cmd_regen}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        sys.stderr.write(USAGE)
        return 2
    scope = threads_core.resolve_scope(os.getcwd())
    if scope is None:
        return 0
    return COMMANDS[argv[0]](scope, argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
